{
  "__inputs": [
    {
      "name": "DS_SQLITE",
      "label": "SQLite",
      "description": "Add the SQLite datasource (fr-ser/grafana-sqlite-datasource plugin) pointing at pond_health.db before importing.",
      "type": "datasource",
      "pluginId": "frser-sqlite-datasource",
      "pluginName": "SQLite"
    }
  ],
  "title": "Pond Health",
  "uid": "pond-health",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "title": "Temperature",
      "type": "timeseries",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "time series",
          "timeColumns": [
            "time"
          ],
          "queryText": "SELECT timestamp * 1000 AS time, temperature_c AS value FROM readings ORDER BY time",
          "rawQueryText": "SELECT timestamp * 1000 AS time, temperature_c AS value FROM readings ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "orange"
              },
              {
                "value": 10.0,
                "color": "green"
              },
              {
                "value": 32.0,
                "color": "orange"
              },
              {
                "value": 35.0,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
